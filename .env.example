APP_ENV=development
APP_NAME=AI WhatsApp Customer Support & Booking Assistant
APP_VERSION=0.1.0
DEMO_COMPANY=Northstar Service Studio
DEFAULT_LANGUAGE=en
BUSINESS_TIMEZONE=Europe/Warsaw
DATABASE_PATH=data/assistant.sqlite3
WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=replace-with-a-local-test-token
WHATSAPP_APP_SECRET=replace-with-a-local-test-secret
WEBHOOK_MAX_BODY_BYTES=262144
CALENDAR_MODE=mock
CALENDAR_CONFIG_PATH=demo/calendar.json
CRM_MODE=mock
GEMINI_MODE=mock
AI_MIN_CONFIDENCE=0.75
KNOWLEDGE_BASE_PATH=demo/knowledge_base.json
LOG_LEVEL=INFO

# Phase 1 deliberately contains no API keys, tokens, phone numbers or OAuth values.
# Add real integration settings only in a later approved phase and keep them in .env.
